# Plantilla de variables de entorno. NO contiene secretos.
#
# En desarrollo: copiar a .env.local y completar.
# En producción: variables del servicio en Railway, POR SITIO. Ninguna lleva el
# prefijo NEXT_PUBLIC_ salvo donde se aclara, justamente para que un único build
# sirva a N clientes sin re-buildear (ver /api/config/auth).

# --- Backend ---------------------------------------------------------------
API_URL=https://siprecomapitest.azurewebsites.net

# Origen público de la app. IMPORTANTE en Railway: detrás del proxy, el origin que
# Next deriva de la request puede ser el interno del contenedor. De ahí salen el
# redirect_uri que se manda al IDP y los redirects a /dashboard y /login, así que
# si queda mal el login federado falla con "redirect_uri mismatch".
# APP_ORIGIN tiene prioridad; si no está, se usa NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_ORIGIN=https://test-ypf.siprecom.com

# --- Login con Microsoft ---------------------------------------------------
# No son secretos: viajan igual al browser dentro del bundle de MSAL.
#
# OJO: MICROSOFT_CLIENT_ID es OBLIGATORIO hoy, incluso en un sitio que solo use
# federación. Si falta, components/msal-provider.tsx tira "MSAL init falló" a
# pantalla completa y la app no arranca — el login incluido.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# --- Federación con el IDP del cliente (YPF / IBM Verify) ------------------
# Solo en los sitios federados. Si falta cualquiera de las tres primeras, el
# botón de ingreso federado no se muestra y /api/auth/ypf/login responde 503.
# Ver Siprecom.Server.Api/Docs/federacion-de-usuarios-mails-ypf.txt

YPF_AUTHORITY=https://ypfidpext-test.verify.ibm.com/oauth2
YPF_CLIENT_ID=

# El client secret. Se aceptan los dos nombres: YPF_CLIENT_SECRET es el claro y
# YPF_CS el opaco, que existe por la policy del tenant que bloquea nombres con
# "Secret"/"Key"/"Password"/"Connection" (igual que ABS_CS en el backend). Esa
# policy aplica a Azure; en Railway podés usar el nombre claro.
YPF_CLIENT_SECRET=

# Opcionales: si no se definen, se arman a partir de APP_ORIGIN. Definilas
# explícitas cuando quieras dejar cero margen de error — tienen que coincidir
# EXACTO con lo registrado en el IDP.
# YPF_REDIRECT_URI=https://test-ypf.siprecom.com/api/auth/callback
# YPF_POST_LOGOUT_REDIRECT_URI=https://test-ypf.siprecom.com/api/auth/logout/callback
# YPF_SCOPE=openid profile email
