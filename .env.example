# Plantilla de variables de entorno. NO contiene secretos.
#
# En desarrollo: copiar a .env.local y completar.
# En Azure: van como Application Settings del Static Web App, POR SITIO. Ninguna
# lleva el prefijo NEXT_PUBLIC_ salvo donde se aclara, justamente para que un
# único build sirva a N clientes sin re-buildear (ver /api/config/auth).

# --- Backend ---------------------------------------------------------------
API_URL=https://siprecomapitest.azurewebsites.net
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Login con Microsoft ---------------------------------------------------
# No son secretos: viajan igual al browser dentro del bundle de MSAL.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# --- Federación con el IDP del cliente (YPF / IBM Verify) ------------------
# Solo en los sitios federados. Si falta cualquiera de las tres primeras, el
# botón de ingreso federado no se muestra y /api/auth/ypf/login responde 503.
# Ver Siprecom.Server.Api/Docs/federacion-de-usuarios-mails-ypf.txt

YPF_AUTHORITY=https://ypfidpext-test.verify.ibm.com/oauth2
YPF_CLIENT_ID=

# El client secret. Se llama YPF_CS y no YPF_CLIENT_SECRET porque la policy del
# tenant bloquea Application Settings con "Secret" (o Key/Password/Connection) en
# el nombre — mismo motivo que ABS_CS en el backend. En .env.local podés usar
# cualquiera de los dos nombres.
YPF_CS=

# Opcionales. Las URIs se derivan del origin de la request si no se definen, pero
# tienen que coincidir EXACTO con lo registrado en el IDP: detrás de un proxy el
# origin que ve Next puede no ser el público.
# YPF_REDIRECT_URI=https://test-ypf.siprecom.com/api/auth/callback
# YPF_POST_LOGOUT_REDIRECT_URI=https://test-ypf.siprecom.com/api/auth/logout/callback
# YPF_SCOPE=openid profile email
